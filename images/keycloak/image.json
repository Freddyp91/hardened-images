{
  "name": "keycloak",
  "title": "Keycloak",
  "description": "Open source identity and access management, rebuilt on a minimal Wolfi base.",
  "upstream": {
    "github": "keycloak/keycloak",
    "image": "quay.io/keycloak/keycloak",
    "imageTagTemplate": "{version}",
    "source": "https://github.com/keycloak/keycloak"
  },
  "usage": "docker run -p 8080:8080 -e KC_BOOTSTRAP_ADMIN_USERNAME=admin -e KC_BOOTSTRAP_ADMIN_PASSWORD=change-me {image} start-dev"
}
